      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1yc09ro0pz5zb7194rxt20ilcx3u].[pcto:usr:Calculation_3354650506399744:qk]&quot;' value='% Total Vehicles ' />
        </aliases>
      </column>
      <column caption='Total Vehicles' datatype='integer' name='[Calculation_3354650506399744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([DOL Vehicle ID])' />
      </column>
      <column caption='Avg Electric Range' datatype='real' name='[Calculation_3354650507948033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='Total BEV Vehicles' datatype='integer' name='[Calculation_3354650509811714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD (&#13;&#10;IF [Electric Vehicle Type] = &quot;Battery ELectric Vehicle (BEV)&quot; &#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END)' />
      </column>
      <column caption='% of BEV' datatype='real' name='[Calculation_3354650510684163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3354650509811714] / [Calculation_3354650506399744]' />
      </column>
      <column caption='Total PHEV Vehicles' datatype='integer' name='[Calculation_3354650511581188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN &#13;&#10;[DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% Of PHEV' datatype='real' name='[Calculation_3354650512248837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3354650511581188] / [Calculation_3354650506399744]' />
      </column>
